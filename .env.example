# Non-secret resource settings. Export these in your terminal; no dotenv loader is used.
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
# local: offline UI mocks; aws: Anderson uses private S3 and the AI owner's agent.
REVENUE_BACKEND=local
# Non-secret resources validated in the event account; change for another account/model.
REVENUE_S3_BUCKET=revenuetwin-514878621897-evidence
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional named credential profile; credentials remain outside the repository.
# AWS_PROFILE=revenue-hackathon
