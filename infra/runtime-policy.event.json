{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndersonEvidence",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::revenuetwin-514878621897-evidence/evidence/anderson/*"
    },
    {
      "Sid": "RecordHumanReview",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::revenuetwin-514878621897-evidence/reviews/CASE-001/*"
    },
    {
      "Sid": "VerifyEvidenceBucketPrivacy",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketPublicAccessBlock", "s3:GetBucketOwnershipControls", "s3:GetBucketPolicyStatus"],
      "Resource": "arn:aws:s3:::revenuetwin-514878621897-evidence"
    },
    {
      "Sid": "InvokeAssignedBedrockModel",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": ["arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0"]
    }
  ]
}
